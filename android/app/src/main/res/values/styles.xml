<resources>
    <!-- Theme applied to the Android Window while the Flutter UI initializes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has
         started. This theme determines the color of the Android Window
         while your Flutter UI initializes, as well as the incoming Flutter
         UI itself. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launchBackground</item>
    </style>
</resources>
